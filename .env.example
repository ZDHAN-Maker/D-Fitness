# ───────── Supabase (Server - Build APIs) ─────────
# These are the primary env vars used by @supabase/server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ───────── Public (safe for the browser) ─────────
# Next.js inlines NEXT_PUBLIC_* at build time. These map to the Supabase vars above.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase "publishable" key (was called "anon" key). Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ───────── Server only — NEVER prefix with NEXT_PUBLIC_ ─────────
# Used only by lib/supabase/admin.ts for trusted server code: contextual notifications (Phase 5) and AI usage logs (Phase 6).
# Without it the app still works; only the contextual reminders are switched off.
# Maps to SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# AI (Phase 6). Google Gemini. Paste your own key here or in your host's environment settings; NEVER commit it,
# paste it into code, or share it in chat or screenshots. Rotate it immediately if it is ever exposed.
AI_PROVIDER=gemini
AI_API_KEY=
# Optional overrides (defaults shown). Model names change often: check Google's current model list.
AI_MODEL_TEXT=gemini-3.8-flash
AI_MODEL_VISION=gemini-3.8-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Per-user limits over any rolling 24 hours (cost control). Needs SUPABASE_SERVICE_ROLE_KEY to be enforced.
AI_DAILY_LIMIT=40
AI_DAILY_VISION_LIMIT=10

# Protects /api/cron/* endpoints called by Vercel Cron (Phase 5/6).
CRON_SECRET=
